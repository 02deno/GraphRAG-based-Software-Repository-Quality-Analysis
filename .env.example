# Copy to ".env" in this project root (gitignored). Values here are not secrets;
# replace placeholders before use. Shell environment still wins over this file
# (load_dotenv(..., override=False)).

# Flask
# FLASK_SECRET_KEY=

# GraphRAG chat (OpenAI-compatible HTTP)
# GRAPHRAG_OPENAI_BASE_URL=https://api.openai.com/v1
# GRAPHRAG_CHAT_MODEL=gpt-4o-mini
# GRAPHRAG_OPENAI_API_KEY=
# Optional: workspace UI context warnings (assembled prompt char heuristic)
# GRAPHRAG_CHAT_WARN_INPUT_CHARS=24000
# GRAPHRAG_CHAT_CRITICAL_INPUT_CHARS=36000

# Optional: embedding seeds (same base URL as chat)
# GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Neo4j subgraph expansion
# GRAPHRAG_NEO4J_URI=bolt://127.0.0.1:7687
# GRAPHRAG_NEO4J_USER=neo4j
# GRAPHRAG_NEO4J_PASSWORD=
# GRAPHRAG_NEO4J_DATABASE=

# Optional: source chunk index (web runs write graphrag_source_chunks.jsonl)
# GRAPHRAG_SOURCE_MAX_FILES=500
# GRAPHRAG_SOURCE_MAX_BYTES_PER_FILE=200000
# GRAPHRAG_SOURCE_CHUNK_LINES=90
# GRAPHRAG_SOURCE_CHUNK_OVERLAP_LINES=12

# Logging
# GRAPHRAG_LOG_LEVEL=INFO
# GRAPHRAG_LOG_FILE=
# GRAPHRAG_LOG_TO_FILE=1
