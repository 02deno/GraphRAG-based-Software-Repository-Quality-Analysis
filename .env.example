# Copy to ".env" in this project root (gitignored). Values here are not secrets;
# replace placeholders before use. By default, existing shell env wins over this
# file (first load_dotenv pass uses override=False). Set GRAPHRAG_DOTENV_OVERRIDE=1
# here (or export it) to run a second pass so keys in this file replace shell
# values — use when a global profile pins e.g. local Ollama to 127.0.0.1:11434.

# Flask
# FLASK_SECRET_KEY=

# GraphRAG chat (OpenAI-compatible HTTP)
# GRAPHRAG_DOTENV_OVERRIDE=1
# GRAPHRAG_OPENAI_BASE_URL=https://api.openai.com/v1
# GRAPHRAG_CHAT_MODEL=gpt-4o-mini
# GRAPHRAG_OPENAI_API_KEY=
# Optional: httpx read timeout for /chat/completions (seconds; increase for slow local Ollama)
# GRAPHRAG_CHAT_TIMEOUT_S=300
# Optional: workspace UI context warnings (assembled prompt char heuristic)
# GRAPHRAG_CHAT_WARN_INPUT_CHARS=24000
# GRAPHRAG_CHAT_CRITICAL_INPUT_CHARS=36000
# Optional: auto session fork (LLM summary → new session) after a reply when approx prompt chars >= this (0 = off). Requires at least one prior exchange in the session so single-turn RAG-heavy prompts do not loop.
# GRAPHRAG_CHAT_AUTO_SUMMARY_AT_CHARS=28000
# Optional: AI insights (results page) — smaller/faster prompts and completions
# GRAPHRAG_INSIGHTS_COMPACT=1
# GRAPHRAG_INSIGHTS_MAX_TOKENS=3072
# Optional: JSON object mode for insights (auto-on for api.openai.com); set 0 for Ollama Cloud if the API rejects response_format
# GRAPHRAG_INSIGHTS_JSON_OBJECT=1
# GRAPHRAG_INSIGHTS_JSON_OBJECT=0

# Optional: embedding seeds (same base URL as chat)
# GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Neo4j subgraph expansion
# GRAPHRAG_NEO4J_URI=bolt://127.0.0.1:7687
# GRAPHRAG_NEO4J_USER=neo4j
# GRAPHRAG_NEO4J_PASSWORD=
# GRAPHRAG_NEO4J_DATABASE=

# Optional: source chunk index (web runs write graphrag_source_chunks.jsonl)
# GRAPHRAG_SOURCE_MAX_FILES=500
# GRAPHRAG_SOURCE_MAX_BYTES_PER_FILE=200000
# GRAPHRAG_SOURCE_CHUNK_LINES=90
# GRAPHRAG_SOURCE_CHUNK_OVERLAP_LINES=12
# Optional: documentation chunks (README, CONTRIBUTING/CHANGELOG/SECURITY at repo root, then all **/*.md under repo); 0 = docs off
# GRAPHRAG_SOURCE_MAX_DOC_FILES=120
# GRAPHRAG_SOURCE_DOC_CHUNK_LINES=120
# GRAPHRAG_SOURCE_DOC_CHUNK_OVERLAP_LINES=24
# Optional: analysis run chunks (analysis_view summary, analysis.txt, visual_summary*) under virtual _analysis/ paths in the same JSONL
# GRAPHRAG_SOURCE_ANALYSIS_CHUNK_LINES=80
# GRAPHRAG_SOURCE_ANALYSIS_CHUNK_OVERLAP_LINES=12
# GRAPHRAG_SOURCE_ANALYSIS_MAX_BYTES=400000
# GRAPHRAG_SOURCE_MAX_CHUNKS_PER_ANALYSIS_FILE=60
# GRAPHRAG_SOURCE_DISABLE_ANALYSIS_CHUNKS=0
# Optional: per-chunk excerpt bytes stored in source_context_diagnostics for workspace UI (0 = omit)
# GRAPHRAG_SOURCE_DIAGNOSTIC_EXCERPT_CHARS=4000

# Logging
# GRAPHRAG_LOG_LEVEL=INFO
# GRAPHRAG_LOG_FILE=
# GRAPHRAG_LOG_TO_FILE=1
